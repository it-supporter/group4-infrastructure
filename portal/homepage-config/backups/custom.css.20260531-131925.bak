/* ===== Group 4 Header ===== */

body::before {
    content: "Group 4 Infrastructure Portal";

    display: flex;
    align-items: center;

    height: 80px;
    padding-left: 100px;
    margin: 20px 0 15px 30px;

    background-image: url('/branding/icons/g4fav.png');
    background-size: 80px 80px;
    background-repeat: no-repeat;
    background-position: left center;

    color: #d4af37;
    font-size: 3rem;
    font-weight: 800;

    text-shadow: 0 0 12px rgba(0,0,0,0.8);

    position: relative;
    z-index: 100;
}
