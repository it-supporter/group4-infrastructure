
/* ===== Group 4 Virtualization Portal ===== */

html,
body,
#__next {
    background-image: url('/branding/wallpapers/cyberleague.png') !important;
    background-size: cover !important;
    background-position: center center !important;
    background-repeat: no-repeat !important;
    background-attachment: fixed !important;
}

/* Dark overlay */
html::before {
    content: "";
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    pointer-events: none;
    z-index: 0;
}

/* Keep Homepage content above overlay */
body > * {
    position: relative;
    z-index: 1;
}

/* Service cards */
div[class*="service"],
div[class*="card"],
div[class*="widget"] {
    background: rgba(20, 20, 35, 0.80) !important;
    backdrop-filter: blur(6px);
}

/* Search bars */
input {
    background: rgba(20, 20, 35, 0.85) !important;
}

/* Group headers */
h1,
h2,
h3 {
    text-shadow: 0 0 8px rgba(0,0,0,0.8);
}
