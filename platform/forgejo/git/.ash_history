q
gitea embedded view public/assets/css/theme-gitea-dark.css > /data/gitea/public/assets/css/theme-pulseai-dark.css
ls -lah /data/gitea/public/assets/css
wc -c /data/gitea/public/assets/css/theme-pulseai-dark.css
exit
forgejo doctor check
forgejo --version
forgejo help
ls -lah /data/gitea/conf
forgejo doctor check --run authorized-keys --fix
forgejo doctor check
kubectl get pods -n argocd
q
grep -n "\[packages\]" /etc/templates/app.ini
grep -n "PACKAGES" /etc/templates/app.ini
grep -n "packages" /etc/templates/app.ini
find / -name app.ini 2>/dev/null
grep -Ri "ENABLE_PACKAGES" / 2>/dev/null
