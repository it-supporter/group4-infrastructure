gitea environment
find /data/gitea -type f | head -50
find /data/gitea -type d | sort
gitea help
exit
gitea embedded --help
gitea embedded list
gitea embedded list | grep -i theme
gitea embedded view public/assets/css/theme-gitea-dark.css | head -100
gitea embedded view public/assets/css/theme-gitea-dark.css > /tmp/gitea-dark.css
head -100 /tmp/gitea-dark.css
mkdir -p /opt/platform/forgejo/data/gitea/public/assets/css
exit
gitea embedded extract --help
gitea embedded view public/assets/css/theme-gitea-dark.css > /tmp/theme-gitea-dark.css
head -50 /tmp/theme-gitea-dark.css
wc -l /tmp/theme-gitea-dark.css
mkdir -p /data/gitea/public/assets/css
gitea embedded view public/assets/css/theme-gitea-dark.css \
> /data/gitea/public/assets/css/theme-pulseai-dark.css
ls -lah /data/gitea/public/assets/css'
